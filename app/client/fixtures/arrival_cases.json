{
  "away_lines": [
    {"name": "plain lines play on the band",
     "chips": [], "shown": [], "cards": [], "cards_before": [],
     "lines": [["a", null], ["b", null]], "expect": ["band", "band"]},
    {"name": "a chip's on-line goes to the Log",
     "chips": [{"chip": "tired", "on": "t_on", "off": "t_off"}], "shown": ["tired"], "cards": [], "cards_before": [],
     "lines": [["t_on", null], ["a", null]], "expect": ["log", "band"]},
    {"name": "off-lines collapse to the last, kept when the chip is not shown",
     "chips": [{"chip": "tired", "on": "t_on", "off": "t_off"}], "shown": [], "cards": [], "cards_before": [],
     "lines": [["t_on", null], ["t_off", null], ["t_off", null]], "expect": ["log", "none", "log"]},
    {"name": "the last off-line is dropped when the chip is shown",
     "chips": [{"chip": "tired", "on": "t_on", "off": "t_off"}], "shown": ["tired"], "cards": [], "cards_before": [],
     "lines": [["t_off", null], ["t_off", null]], "expect": ["none", "none"]},
    {"name": "a chip with no off-line key sends nothing else",
     "chips": [{"chip": "tired", "on": "t_on", "off": null}], "shown": [], "cards": [], "cards_before": [],
     "lines": [["t_on", null], ["a", null]], "expect": ["log", "band"]},
    {"name": "a chip's key written by a card is that card's line",
     "chips": [{"chip": "tired", "on": "t_on", "off": "t_off"}], "shown": [], "cards": [{"card": "c", "cap": 3}], "cards_before": [],
     "lines": [["t_on", "c"]], "expect": ["band"]},
    {"name": "an uncapped card's line goes to the Log, a capped card's plays",
     "chips": [], "shown": [], "cards": [{"card": "rest", "cap": null}, {"card": "c", "cap": 3}], "cards_before": [],
     "lines": [["r", "rest"], ["l", "c"]], "expect": ["log", "band"]},
    {"name": "a repeat card known only from the view before still goes to the Log",
     "chips": [], "shown": [], "cards": [], "cards_before": [{"card": "rest", "cap": null}],
     "lines": [["r", "rest"], ["a", null]], "expect": ["log", "band"]}
  ],
  "schedule": [
    {"name": "nothing", "holds_ms": [], "rest": 0, "end_ms": 0},
    {"name": "one line is its reading time", "holds_ms": [3000], "rest": 0, "end_ms": 3000},
    {"name": "lines add", "holds_ms": [3000, 3500, 4000], "rest": 0, "end_ms": 10500},
    {"name": "one arrival comes at once", "holds_ms": [], "rest": 1, "end_ms": 0},
    {"name": "two arrivals take the widest gap", "holds_ms": [], "rest": 2, "end_ms": 700},
    {"name": "a few take the widest gap", "holds_ms": [], "rest": 4, "end_ms": 2100},
    {"name": "more spread within the cap", "holds_ms": [], "rest": 8, "end_ms": 4000},
    {"name": "eleven fit at the narrowest gap", "holds_ms": [], "rest": 11, "end_ms": 4000},
    {"name": "past the cap the rest share its last turn", "holds_ms": [], "rest": 30, "end_ms": 4000},
    {"name": "the rest follow the lines", "holds_ms": [3000, 3000], "rest": 3, "end_ms": 7400},
    {"name": "a ledger line holds the cards behind it", "holds_ms": [3000], "rest": 3, "ledger_ms": [3000], "behind": 2, "end_ms": 6700},
    {"name": "the ledger's longest hold, once", "holds_ms": [], "rest": 4, "ledger_ms": [3000, 4200], "behind": 1, "end_ms": 5600},
    {"name": "nothing behind the ledger, no wait", "holds_ms": [], "rest": 2, "ledger_ms": [3000], "behind": 0, "end_ms": 700},
    {"name": "past the cap the hold still comes first", "holds_ms": [], "rest": 30, "ledger_ms": [3000], "behind": 29, "end_ms": 6600}
  ]
}
